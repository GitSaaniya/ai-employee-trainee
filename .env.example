# Copy to .env.local and fill in values. Never commit secrets.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GLADIA_API_KEY=
SARVAM_API_KEY=
# Best-quality English assessor defaults (Bulbul v3)
SARVAM_SPEAKER=ishita
SARVAM_GENDER=female
SARVAM_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SAMPLE_RATE=24000
# Optional overrides — if unset, each voice uses its natural delivery profile
# SARVAM_PACE=0.98
# SARVAM_TTS_TEMPERATURE=0.78

NEXT_PUBLIC_SILERO_STOP_SECS=1.2
NEXT_PUBLIC_SILERO_START_SECS=0.15
NEXT_PUBLIC_SILERO_VAD_CONFIDENCE=0.5
NEXT_PUBLIC_SILERO_MIN_VOLUME=0.08
NEXT_PUBLIC_BARGE_IN_MIN_VOLUME_DB=-28
NEXT_PUBLIC_BARGE_IN_DEBOUNCE_MS=220
NEXT_PUBLIC_MIN_STT_CONFIDENCE=0.15

# Auth — required for login (do not commit real secrets)
ADMIN_EMAIL=admin@skillsim.ai
ADMIN_NAME=Aisha Khan
ADMIN_PASSWORD=change-me-admin
EMPLOYEE_EMAIL=manu.nair@knolskape.in
EMPLOYEE_NAME=Manu Nair
EMPLOYEE_PASSWORD=change-me-employee

# MongoDB Atlas — required for shared persistence on Vercel
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skillsim?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=skillsim
